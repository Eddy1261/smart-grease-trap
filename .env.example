# Smart Grease Trap - Environment Configuration Template
# Copy this file to .env for local runtime configuration.

# ==========================================
# MQTT BROKER CONFIGURATION
# ==========================================
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TELEMETRY_TOPIC=smart_grease_trap/telemetry
MQTT_COMMAND_TOPIC=smart_grease_trap/command
MQTT_CLIENT_ID=sgt_backend_dev
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEP_ALIVE=60

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Use sqlite:///./data/smart_grease_trap.db for local persistence, or sqlite:///:memory: for testing
DATABASE_URL=sqlite:///./data/smart_grease_trap.db

# ==========================================
# REST API CONFIGURATION
# ==========================================
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
LOG_LEVEL=INFO

# ==========================================
# REMOTE ACCESS PROTECTION (Cloudflare Tunnel)
# ==========================================
# Shared secret required by the dashboard/API when accessed through a tunnel.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = local-only mode (public/tunnel traffic is refused with HTTP 503).
# Never commit the real token. Change it and restart the backend to revoke
# existing browser cookies.
DASHBOARD_ACCESS_TOKEN=
# Login cookie lifetime in seconds (default 30 days).
ACCESS_COOKIE_MAX_AGE=2592000
# Comma-separated allowlist for separate dev origins (e.g. http://localhost:5173).
# Empty = no CORS middleware; dashboard + API are same-origin and need none.
CORS_ALLOW_ORIGINS=

# ==========================================
# SYSTEM CALIBRATION & SIMULATION DEFAULTS
# (Note: Physical parameters to be tuned during Phase 2)
# ==========================================
DEFAULT_DEVICE_ID=SGT-001
DEFAULT_SURFACE_AREA_CM2=900.0
DEFAULT_ALPHA_CORR=0.75
DEFAULT_EMA_ALPHA=0.20
DEFAULT_CRITICAL_VOLUME_ML=250.0
DEFAULT_DEBOUNCE_CYCLES=3
DEFAULT_SAMPLING_INTERVAL_S=30.0

# Backend classifier thresholds (configured proxies)
THRESHOLD_TURBIDITY_EMULSION_NTU=150.0
THRESHOLD_OIL_CONCENTRATION_MG_L=10.0
THRESHOLD_CONTAINER_MAX_MASS_G=4000.0
THRESHOLD_CONTAINER_NEAR_FULL_G=4000.0

# ==========================================
# REPORTING & ARTIFACTS
# ==========================================
REPORTS_DIR=./data/reports
DASHBOARD_STATIC_DIR=./dashboard

# ==========================================
# FIREBASE / FCM NOTIFICATIONS
# ==========================================
# Path to the Firebase service-account JSON. Keep it OUTSIDE the repository.
# NEVER commit the service-account file or its private key.
FIREBASE_CREDENTIALS_PATH=
# auto | true | false — auto enables delivery when credentials + firebase-admin are available
FCM_ENABLED=auto
# Public VAPID key (Firebase Console -> Cloud Messaging -> Web Push certificates)
FCM_VAPID_KEY=
# Firebase Web App configuration (public client identifiers, no private key)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=
# Dedup cooldown for repeated notification events (seconds)
FCM_DEDUP_COOLDOWN_SECONDS=300
